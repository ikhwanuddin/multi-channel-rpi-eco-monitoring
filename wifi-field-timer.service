# ── MAARU field WiFi timer ──────────────────────────────────────────
# WiFi ON for the first MAX_ON_SECONDS after boot (default 1200 = 20 min),
# or until no-link grace expires. Then sleeps until reboot.
# Prefer: sudo python3 installer.py → menu "Field WiFi timer"
# See wifi_field_timer.sh and docs/advanced_configuration.md
# ────────────────────────────────────────────────────────────────────

[Unit]
Description=MAARU field WiFi timer (on after boot, then sleep until reboot)
Documentation=file://__REPO_DIR__/docs/advanced_configuration.md
# Start once the network stack exists so wlan interfaces can appear.
# Do NOT use Before=eco-monitor: this job can run for many minutes and
# must not delay the recorder.
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
# Defaults baked in for field power saving (override via installer or edit).
Environment=MAX_ON_SECONDS=1200
Environment=NO_LINK_GRACE_SECONDS=900
Environment=CHECK_INTERVAL=30
ExecStart=/bin/bash __REPO_DIR__/wifi_field_timer.sh
# Run once per boot; do not restart after WiFi has been put to sleep.
Restart=no

[Install]
WantedBy=multi-user.target
