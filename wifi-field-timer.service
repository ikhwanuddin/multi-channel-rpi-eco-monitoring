# ── MAARU field WiFi timer ──────────────────────────────────────────
# WiFi ON while wlan is linked (no time cap). After wlan is gone for
# NO_LINK_GRACE_SECONDS (default 1200 = 20 min), soft-sleep until reboot
# (wlan down / NM disconnect — not rfkill / not nmcli radio off).
# Prefer: sudo python3 installer.py → menu "Field WiFi timer"
# See wifi_field_timer.sh and docs/advanced_configuration.md
# ────────────────────────────────────────────────────────────────────

[Unit]
Description=MAARU field WiFi timer (keep-alive while linked, sleep after no-link grace)
Documentation=file://__REPO_DIR__/docs/advanced_configuration.md
# Start once the network stack exists so wlan interfaces can appear.
# Do NOT use Before=eco-monitor: this job can run for many minutes and
# must not delay the recorder.
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
# Defaults for field power saving (override via installer or edit).
Environment=NO_LINK_GRACE_SECONDS=1200
Environment=CHECK_INTERVAL=30
ExecStart=/bin/bash __REPO_DIR__/wifi_field_timer.sh
# Run once per boot; do not restart after WiFi has been soft-slept.
Restart=no

[Install]
WantedBy=multi-user.target
